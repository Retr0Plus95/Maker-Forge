{
  "name": "maker-forge",
  "version": "0.17.2",
  "private": true,
  "description": "Browser-based multi-colour 3D printing studio. The app needs no build tools; these are the test dependencies.",
  "license": "MIT",
  "scripts": {
    "build": "python3 build.py",
    "fonts": "node tools-fonts.js",
    "test:tracer": "node tools-tracer-test.js index.html && node tools-tracer-paper-test.js index.html && node tools-tracer-logo-test.js index.html && node tools-tracer-plate-test.js index.html",
    "test:smoke": "node tools-smoke-test.js index.html",
    "test:audit": "node tools-audit.js index.html",
    "test:print": "node tools-printability-test.js index.html && node tools-printability-app-test.js index.html",
    "survey:print": "node tools-print-survey.js index.html",
    "test:jigsaw": "node tools-jigsaw-test.js index.html",
    "test:litho": "node tools-lithophane-test.js index.html",
    "test:enclosure": "node tools-enclosure-test.js index.html",
    "test:size": "node tools-size-check.js index.html",
    "check:browser": "node tools-browser-check.js index.html",
    "test:paint": "node tools-paint-test.js index.html",
    "test:phonecase": "node tools-phonecase-test.js index.html",
    "test:art": "node tools-art-test.js index.html",
    "test:project": "node tools-project-test.js index.html"
  },
  "devDependencies": {
    "@fontsource/alfa-slab-one": "5.3.0",
